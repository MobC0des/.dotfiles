[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = true

[core]
	editor = "hx"
	fsmonitor = true

[fetch]
	prune = true
	writeCommitGraph = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "ssh"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[rebase]
	updateRefs = true

[rerere]
	enabled = true

[tag]
	gpgSign = true

[user]
	email = "yami@00.codes"
	name = "MobC0des"
	signingKey = "~/.ssh/id_rsa.pub"

[includeIf "gitdir:~/Sites/"]
	path = "~/.config/git/work_config"
